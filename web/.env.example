# Supabase接続。未設定なら ../output/*.json をローカルから読む。
# Vercelでは必ず設定すること。設定しないとデータが一切表示されない
# （Vercel上にoutput/は存在しないため）。
#
# 値は Supabase の Project Settings > API から取得する。
# anonキーはブラウザに露出する前提のもので、schema.sql のRLSにより
# 読み取りだけが許可されている。service_roleキーは絶対に置かないこと。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
