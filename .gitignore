__pycache__/
*.pyc

# 過去日ページのHTMLキャッシュ。再取得可能なのでコミットしない。
cache/

# 収集したレースデータは追跡しない。
# 公式サイトのデータを再配布しないため、また毎日数百KBずつ
# 履歴が肥大化するのを避けるため。データの置き場はSupabase。
# tests/fixtures/ のHTMLだけは回帰テストに必要なので例外的に含める。
output/

web/node_modules/
web/.next/

# tsc --noEmit が吐く増分ビルド情報。生成物なので追跡しない。
web/tsconfig.tsbuildinfo

# Vercel / Next.js のローカル環境変数
web/.env*.local
.vercel
